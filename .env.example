# Server/runtime
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host:5432/feasty
JWT_SECRET=replace-with-a-long-random-secret
OWNER_OPEN_ID=replace-with-owner-identity
OAUTH_SERVER_URL=
VITE_APP_ID=

# Clerk migration target (server-side secret; publishable key is safe for browser build)
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# LLM / built-in server integration
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Browser runtime is referenced by profile ID; raw passwords and cookies do not belong here.
BROWSER_RUNTIME_URL=
BROWSER_RUNTIME_API_KEY=
